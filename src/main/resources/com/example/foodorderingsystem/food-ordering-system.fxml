<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="433.0" prefWidth="431.0" spacing="20.0" stylesheets="@../../../../../Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.foodorderingsystem.foodOrderingSystemController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <AnchorPane prefHeight="384.0" prefWidth="391.0">
      <children>
      
          <Label fx:id="welcomeText" layoutX="249.0" layoutY="55.0" text="Discount">
            <font>
               <Font size="15.0" />
            </font>
         </Label>
         <Label fx:id="welcomeText1" layoutX="74.0" layoutY="55.0" text="Foods">
            <font>
               <Font size="15.0" />
            </font>
         </Label>
         <CheckBox fx:id="cPizza" layoutX="26.0" layoutY="100.0" mnemonicParsing="false" onAction="#onMenuClick" text="Pizza               Php 100 " />
         <CheckBox fx:id="cBurger" layoutX="26.0" layoutY="150.0" mnemonicParsing="false" onAction="#onMenuClick" text="Burger             Php 80" />
         <CheckBox fx:id="cFries" layoutX="26.0" layoutY="200.0" mnemonicParsing="false" onAction="#onMenuClick" text="Fries                Php 65" />
         <CheckBox fx:id="cSoftDrinks" layoutX="26.0" layoutY="250.0" mnemonicParsing="false" onAction="#onMenuClick" text="Softdrinks       Php 55" />
         <CheckBox fx:id="cTea" layoutX="26.0" layoutY="300.0" mnemonicParsing="false" onAction="#onMenuClick" text="Tea                 Php 50" />
         <CheckBox fx:id="cSundae" layoutX="26.0" layoutY="350.0" mnemonicParsing="false" onAction="#onMenuClick" text="Sundae           Php 40" />
         <RadioButton fx:id="rbNone" layoutX="249.0" layoutY="100.0" mnemonicParsing="false" onAction="#onDiscountClick" text="None" />
         <RadioButton fx:id="rb5" layoutX="249.0" layoutY="150.0" mnemonicParsing="false" onAction="#onDiscountClick" text="5% Off" />
         <RadioButton fx:id="rb10" layoutX="249.0" layoutY="200.0" mnemonicParsing="false" onAction="#onDiscountClick" text="10% Off" />
         <RadioButton fx:id="rb15" layoutX="249.0" layoutY="250.0" mnemonicParsing="false" onAction="#onDiscountClick" text="15% Off" />
         <Button fx:id="btnOrder" layoutX="148.0" layoutY="417.0" mnemonicParsing="false" onAction="#onOrderClick" prefHeight="38.0" prefWidth="95.0" text="Order">
            <font>
               <Font size="16.0" />
            </font>
         </Button>
      </children>
   </AnchorPane>
</VBox>
